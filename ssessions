#!/usr/bin/env bash
# SSessions - gestionnaire tmux en Bash
# Version 1.1.0

set -u

APP="SSessions"
VERSION="1.1"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ssessions"
PROFILE_DIR="$CONFIG_DIR/profiles"
CONFIG="$CONFIG_DIR/config"

# Fichier système listant les profils à démarrer au boot du serveur.
# Format : un profil par ligne
#   nom_profil        -> démarré pour l'utilisateur qui exécute l'autostart
#   utilisateur:nom   -> démarré uniquement pour cet utilisateur
# Les lignes vides et celles commençant par # sont ignorées.
AUTOSTART_CONF="${SSESSIONS_AUTOSTART_CONF:-/etc/ssessions/ssessions.conf}"
SERVICE_NAME="ssessions-autostart@"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"

mkdir -p "$PROFILE_DIR"

# Configuration par défaut
if [[ ! -f "$CONFIG" ]]; then
    cat > "$CONFIG" <<'EOF'
REMOTE_USER="user"
REMOTE_HOST="server_ip"
REMOTE_DIRECTORY="/home/serveur/downloads"
LOCAL_DIRECTORY="$HOME/Downloads"
EOF
fi

# shellcheck disable=SC1090
source "$CONFIG"

# ---------- Utilitaires ----------

pause() {
    echo
    read -r -p "Appuie sur Entrée pour continuer..." _
}

header() {
    clear 2>/dev/null || true
    echo "================================"
    echo "          $APP v$VERSION"
    echo "================================"
    echo
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Erreur : '$1' n'est pas installé."
        return 1
    fi
}

valid_name() {
    [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]]
}

confirm() {
    local answer
    read -r -p "$1 [o/N] " answer
    [[ "$answer" =~ ^[oOyY]$ ]]
}

# Exécute une commande avec les droits root (directement ou via sudo).
run_privileged() {
    if ((EUID == 0)); then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        echo "Erreur : droits root requis (sudo introuvable)." >&2
        return 1
    fi
}

current_user() {
    id -un
}

# ---------- Sessions tmux ----------

list_sessions() {
    require_command tmux || return
    echo "Sessions disponibles :"
    tmux list-sessions 2>/dev/null || echo "Aucune session active."
}

create_session() {
    require_command tmux || return

    local name directory command_line answer
    read -r -p "Nom de la session : " name

    if ! valid_name "$name"; then
        echo "Nom invalide. Utilise lettres, chiffres, _ ou -."
        return
    fi

    if tmux has-session -t "=$name" 2>/dev/null; then
        echo "Une session nommée '$name' existe déjà."
        return
    fi

    read -r -p "Répertoire de départ [$HOME] : " directory
    directory="${directory:-$HOME}"

    if [[ ! -d "$directory" ]]; then
        echo "Le répertoire n'existe pas."
        return
    fi

    read -r -p "Commande à lancer (vide = shell interactif) : " command_line

    tmux new-session -d -s "$name" -c "$directory" || {
        echo "Impossible de créer la session."
        return
    }

    if [[ -n "$command_line" ]]; then
        tmux send-keys -t "=$name" -- "$command_line" C-m
    fi

    echo "Session '$name' créée."
    read -r -p "Rejoindre maintenant ? [o/N] " answer
    if [[ "$answer" =~ ^[oOyY]$ ]]; then
        tmux attach-session -t "=$name"
    fi
}

attach_session() {
    require_command tmux || return
    local name="${1:-}"
    [[ -n "$name" ]] || read -r -p "Nom de la session : " name

    if tmux has-session -t "=$name" 2>/dev/null; then
        tmux attach-session -t "=$name"
    else
        echo "Session introuvable."
    fi
}

kill_session() {
    require_command tmux || return
    local name="${1:-}"
    [[ -n "$name" ]] || read -r -p "Session à terminer : " name

    if ! tmux has-session -t "=$name" 2>/dev/null; then
        echo "Session introuvable."
        return
    fi

    if confirm "Confirmer la fermeture de '$name' ?"; then
        tmux kill-session -t "=$name"
        echo "Session terminée."
    fi
}

# ---------- Autostart (/etc/ssessions/ssessions.conf) ----------

autostart_entry() {
    # Entrée liée à l'utilisateur courant
    echo "$(current_user):$1"
}

autostart_ensure_file() {
    if [[ ! -f "$AUTOSTART_CONF" ]]; then
        run_privileged mkdir -p "$(dirname "$AUTOSTART_CONF")" || return 1
        {
            echo "# SSessions - profils démarrés au boot du serveur"
            echo "# Format : nom_profil  ou  utilisateur:nom_profil"
        } | run_privileged tee "$AUTOSTART_CONF" >/dev/null || return 1
        run_privileged chmod 644 "$AUTOSTART_CONF"
    fi
}

autostart_has() {
    [[ -f "$AUTOSTART_CONF" ]] && grep -qxF -- "$1" "$AUTOSTART_CONF"
}

autostart_add() {
    local name="${1:-}"
    [[ -n "$name" ]] || read -r -p "Profil à démarrer au boot : " name

    if ! valid_name "$name"; then
        echo "Nom invalide."
        return 1
    fi

    if [[ ! -f "$PROFILE_DIR/$name.conf" ]]; then
        echo "Profil introuvable."
        return 1
    fi

    local entry
    entry="$(autostart_entry "$name")"

    if autostart_has "$entry"; then
        echo "'$name' est déjà dans l'autostart."
        return 0
    fi

    autostart_ensure_file || return 1
    printf '%s\n' "$entry" | run_privileged tee -a "$AUTOSTART_CONF" >/dev/null || return 1
    echo "'$name' sera démarré au boot ($AUTOSTART_CONF)."
}

autostart_remove() {
    local name="${1:-}"
    [[ -n "$name" ]] || read -r -p "Profil à retirer de l'autostart : " name

    if ! valid_name "$name"; then
        echo "Nom invalide."
        return 1
    fi

    local entry tmp
    entry="$(autostart_entry "$name")"

    if ! autostart_has "$entry"; then
        echo "'$name' n'est pas dans l'autostart."
        return 0
    fi

    tmp="$(mktemp)" || return 1
    grep -vxF -- "$entry" "$AUTOSTART_CONF" > "$tmp" || true
    run_privileged install -m 644 "$tmp" "$AUTOSTART_CONF"
    local rc=$?
    rm -f "$tmp"
    ((rc == 0)) && echo "'$name' retiré de l'autostart."
    return "$rc"
}

autostart_list() {
    if [[ ! -f "$AUTOSTART_CONF" ]]; then
        echo "Aucun fichier $AUTOSTART_CONF (rien en autostart)."
        return
    fi

    echo "Autostart ($AUTOSTART_CONF) :"
    local line found=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line//[[:space:]]/}"
        [[ -z "$line" ]] && continue
        echo "- $line"
        found=1
    done < "$AUTOSTART_CONF"
    ((found)) || echo "(vide)"
}

# Appelé au démarrage du serveur : lit ssessions.conf et lance les profils.
autostart_run() {
    require_command tmux || return 1

    if [[ ! -f "$AUTOSTART_CONF" ]]; then
        echo "Aucun fichier $AUTOSTART_CONF, rien à démarrer."
        return 0
    fi

    local me line owner name
    me="$(current_user)"

    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line//[[:space:]]/}"
        [[ -z "$line" ]] && continue

        if [[ "$line" == *:* ]]; then
            owner="${line%%:*}"
            name="${line#*:}"
            [[ "$owner" == "$me" ]] || continue
        else
            name="$line"
        fi

        if ! valid_name "$name"; then
            echo "Entrée ignorée (nom invalide) : $line" >&2
            continue
        fi

        start_profile_core "$name" || echo "Échec du démarrage de '$name'." >&2
    done < "$AUTOSTART_CONF"
}

# Installe un service systemd qui lance "ssessions autostart-run" au boot.
autostart_install_service() {
    require_command systemctl || return 1

    local user
    user="$(current_user)"

    echo "Installation de $SERVICE_FILE (utilisateur : $user)..."

    run_privileged tee "$SERVICE_FILE" >/dev/null <<EOF
[Unit]
Description=SSessions autostart pour %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=%i
Environment=TERM=xterm-256color
ExecStart=$SELF autostart-run
# Les serveurs tmux doivent survivre à la fin du script de démarrage.
KillMode=process

[Install]
WantedBy=multi-user.target
EOF
    [[ $? -eq 0 ]] || return 1

    run_privileged systemctl daemon-reload || return 1
    run_privileged systemctl enable "${SERVICE_NAME}${user}.service" || return 1
    echo "Service activé : ${SERVICE_NAME}${user}.service"
    echo "Test immédiat : sudo systemctl start ${SERVICE_NAME}${user}.service"
}

autostart_menu() {
    local choice
    while true; do
        header
        cat <<'MENU'
Autostart (démarrage au boot)
1. Lister les profils en autostart
2. Ajouter un profil à l'autostart
3. Retirer un profil de l'autostart
4. Installer le service systemd
5. Lancer l'autostart maintenant
0. Retour
MENU
        echo
        read -r -p "Choix : " choice
        case "$choice" in
            1) autostart_list; pause ;;
            2) autostart_add; pause ;;
            3) autostart_remove; pause ;;
            4) autostart_install_service; pause ;;
            5) autostart_run; pause ;;
            0) break ;;
            *) echo "Choix invalide."; pause ;;
        esac
    done
}

# ---------- Profils ----------

create_profile() {
    local name directory command_line description file

    read -r -p "Nom du profil : " name
    if ! valid_name "$name"; then
        echo "Nom invalide."
        return
    fi

    file="$PROFILE_DIR/$name.conf"
    if [[ -e "$file" ]]; then
        echo "Ce profil existe déjà."
        return
    fi

    read -r -p "Description : " description
    read -r -p "Répertoire de départ : " directory
    read -r -p "Commande à lancer : " command_line

    if [[ ! -d "$directory" ]]; then
        echo "Attention : ce répertoire n'existe pas actuellement."
    fi

    # Écriture de valeurs en échappant les caractères spéciaux du shell.
    {
        printf 'DESCRIPTION=%q\n' "$description"
        printf 'DIRECTORY=%q\n' "$directory"
        printf 'COMMAND=%q\n' "$command_line"
    } > "$file"

    chmod 600 "$file"
    echo "Profil créé : $name"

    if confirm "Démarrer ce profil automatiquement au boot du serveur ?"; then
        autostart_add "$name"
    fi
}

list_profiles() {
    local file name mark
    shopt -s nullglob
    local files=("$PROFILE_DIR"/*.conf)
    shopt -u nullglob

    if ((${#files[@]} == 0)); then
        echo "Aucun profil enregistré."
        return
    fi

    for file in "${files[@]}"; do
        name="$(basename "$file" .conf)"
        mark=""
        if autostart_has "$(autostart_entry "$name")" || autostart_has "$name"; then
            mark=" [autostart]"
        fi
        if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$name" 2>/dev/null; then
            mark="$mark [actif]"
        fi
        echo "- $name$mark"
    done
}

# Démarre un profil sans aucune interaction (utilisé aussi par l'autostart).
start_profile_core() {
    local name="$1" file directory command_line description

    file="$PROFILE_DIR/$name.conf"
    if [[ ! -f "$file" ]]; then
        echo "Profil introuvable : $name" >&2
        return 1
    fi

    # Les fichiers de profil sont des fichiers de configuration shell.
    # Ne lance que des profils que tu as créés et auxquels tu fais confiance.
    unset DESCRIPTION DIRECTORY COMMAND
    # shellcheck disable=SC1090
    source "$file"

    directory="${DIRECTORY:-$HOME}"
    command_line="${COMMAND:-}"
    description="${DESCRIPTION:-$name}"

    if [[ ! -d "$directory" ]]; then
        echo "Répertoire inexistant : $directory" >&2
        return 1
    fi

    if tmux has-session -t "=$name" 2>/dev/null; then
        echo "La session '$name' existe déjà."
        return 0
    fi

    tmux new-session -d -s "$name" -c "$directory" || return 1

    if [[ -n "$command_line" ]]; then
        tmux send-keys -t "=$name" -- "$command_line" C-m
    fi

    echo "$description : session '$name' démarrée."
}

start_profile() {
    require_command tmux || return

    local name="${1:-}" answer
    [[ -n "$name" ]] || read -r -p "Nom du profil à lancer : " name

    if ! valid_name "$name"; then
        echo "Nom invalide."
        return
    fi

    start_profile_core "$name" || return

    if tmux has-session -t "=$name" 2>/dev/null; then
        read -r -p "Rejoindre maintenant ? [o/N] " answer
        if [[ "$answer" =~ ^[oOyY]$ ]]; then
            tmux attach-session -t "=$name"
        fi
    fi
}

stop_profile() {
    require_command tmux || return

    local name="${1:-}"
    [[ -n "$name" ]] || read -r -p "Nom du profil à arrêter : " name

    if ! valid_name "$name"; then
        echo "Nom invalide."
        return
    fi

    if [[ ! -f "$PROFILE_DIR/$name.conf" ]]; then
        echo "Profil introuvable."
        return
    fi

    if ! tmux has-session -t "=$name" 2>/dev/null; then
        echo "Le profil '$name' n'est pas en cours d'exécution."
        return
    fi

    if confirm "Arrêter la session du profil '$name' ?"; then
        tmux kill-session -t "=$name"
        echo "Profil '$name' arrêté."
    fi
}

delete_profile() {
    local name="${1:-}" file
    [[ -n "$name" ]] || read -r -p "Nom du profil à supprimer : " name

    if ! valid_name "$name"; then
        echo "Nom invalide."
        return
    fi

    file="$PROFILE_DIR/$name.conf"
    if [[ ! -f "$file" ]]; then
        echo "Profil introuvable."
        return
    fi

    if ! confirm "Supprimer définitivement le profil '$name' ?"; then
        return
    fi

    # Arrêt de la session si elle tourne
    if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$name" 2>/dev/null; then
        if confirm "La session '$name' est active. L'arrêter aussi ?"; then
            tmux kill-session -t "=$name"
            echo "Session arrêtée."
        fi
    fi

    # Retrait de l'autostart
    if autostart_has "$(autostart_entry "$name")"; then
        autostart_remove "$name"
    fi
    if autostart_has "$name"; then
        echo "Note : l'entrée globale '$name' reste dans $AUTOSTART_CONF"
        echo "       (supprime-la manuellement si nécessaire)."
    fi

    rm -f -- "$file"
    echo "Profil '$name' supprimé."
}

# ---------- Transferts SCP ----------

upload_file() {
    require_command scp || return

    local file
    read -r -p "Chemin du fichier local : " file

    if [[ ! -f "$file" ]]; then
        echo "Fichier introuvable."
        return
    fi

    scp -- "$file" \
        "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIRECTORY}/"
}

download_file() {
    require_command scp || return

    local name
    read -r -p "Nom du fichier distant : " name

    if [[ -z "$name" || "$name" == */* || "$name" == *".."* ]]; then
        echo "Indique uniquement un nom de fichier simple."
        return
    fi

    mkdir -p "$LOCAL_DIRECTORY"

    scp -- "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIRECTORY}/${name}" \
        "$LOCAL_DIRECTORY/"
}

# ---------- Configuration ----------

edit_config() {
    local editor="${EDITOR:-nano}"
    "$editor" "$CONFIG"
    echo "Configuration modifiée."
}

# ---------- Menu ----------

menu() {
    local choice
    while true; do
        header
        cat <<'MENU'
1. Créer une session
2. Lister les sessions
3. Rejoindre une session
4. Terminer une session
5. Créer un profil
6. Lister les profils
7. Démarrer un profil
8. Arrêter un profil
9. Supprimer un profil
10. Autostart au boot
11. Envoyer un fichier (SCP)
12. Télécharger un fichier (SCP)
13. Modifier la configuration
0. Quitter
MENU
        echo
        read -r -p "Choix : " choice

        case "$choice" in
            1) create_session; pause ;;
            2) list_sessions; pause ;;
            3) attach_session ;;
            4) kill_session; pause ;;
            5) create_profile; pause ;;
            6) list_profiles; pause ;;
            7) start_profile; pause ;;
            8) stop_profile; pause ;;
            9) delete_profile; pause ;;
            10) autostart_menu ;;
            11) upload_file; pause ;;
            12) download_file; pause ;;
            13) edit_config ;;
            0) break ;;
            *) echo "Choix invalide."; pause ;;
        esac
    done
}

# ---------- Commandes directes ----------

usage() {
    cat <<'EOF'
Usage : ssessions [commande]

  (aucune)                 menu interactif
  list                     lister les sessions
  create                   créer une session
  attach [session]         rejoindre une session
  kill [session]           terminer une session
  profiles                 lister les profils
  start [profil]           démarrer un profil
  stop [profil]            arrêter un profil
  delete [profil]          supprimer un profil
  autostart list           lister les profils lancés au boot
  autostart add [profil]   ajouter un profil à l'autostart
  autostart remove [profil] retirer un profil de l'autostart
  autostart install        installer le service systemd
  autostart-run            lancer les profils de l'autostart (utilisé au boot)
  config                   modifier la configuration
  upload                   envoyer un fichier (SCP)
  download                 télécharger un fichier (SCP)
EOF
}

case "${1:-}" in
    "")
        menu
        ;;
    list)
        list_sessions
        ;;
    create)
        create_session
        ;;
    attach)
        attach_session "${2:-}"
        ;;
    kill)
        kill_session "${2:-}"
        ;;
    profiles)
        list_profiles
        ;;
    start)
        start_profile "${2:-}"
        ;;
    stop)
        stop_profile "${2:-}"
        ;;
    delete)
        delete_profile "${2:-}"
        ;;
    autostart)
        case "${2:-}" in
            list|"") autostart_list ;;
            add) autostart_add "${3:-}" ;;
            remove) autostart_remove "${3:-}" ;;
            install) autostart_install_service ;;
            run) autostart_run ;;
            *) echo "Usage : ssessions autostart [list|add|remove|install|run]"; exit 2 ;;
        esac
        ;;
    autostart-run)
        autostart_run
        ;;
    config)
        edit_config
        ;;
    upload)
        upload_file
        ;;
    download)
        download_file
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Commande inconnue : $1"
        echo "Utilise 'ssessions --help'."
        exit 2
        ;;
esac
